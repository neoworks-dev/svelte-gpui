{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": [],
    "typeRoots": [],
    "resolveJsonModule": true,
    "paths": {
      "@neoworks/svelte-gpui": ["./runtime/index.ts"],
      "@neoworks/svelte-gpui/ui": ["./runtime/ui/index.ts"]
    }
  },
  "include": ["runtime", "examples/*/src"]
}
